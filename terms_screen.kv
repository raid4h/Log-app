# terms_screen.kv
# Full-screen scrollable Terms & Conditions + checkbox + Agree/Decline.
# No back button -- this screen is a gate, not a normal navigable screen.
#
# root_layout has an explicit id so terms_screen.py can pad its
# bottom at runtime by the real Android gesture-nav-bar height (see
# theme/safe_area.py) -- otherwise Decline/I Agree can render
# partially or fully under the system gesture bar on Android 15+
# devices, where taps in that zone get consumed by the OS's
# back-swipe gesture instead of reaching the button.

<TermsScreen>:

    MDBoxLayout:
        id: root_layout
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(14)

        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(56)

            MDLabel:
                id: header_label
                text: "Terms & Conditions"
                theme_text_color: "Custom"
                font_style: "Title"
                role: "medium"

            MDLabel:
                id: subtitle_label
                text: "Please read before continuing"
                theme_text_color: "Custom"
                font_style: "Body"
                role: "small"

        ScrollView:
            do_scroll_x: False

            MDLabel:
                id: terms_label
                text: ""
                theme_text_color: "Custom"
                font_style: "Body"
                role: "small"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                padding: dp(4), dp(8)

        MDBoxLayout:
            id: checkbox_row
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)

            MDCheckbox:
                id: agree_checkbox
                size_hint: None, None
                size: dp(32), dp(32)
                pos_hint: {"center_y": 0.5}
                on_active: root.on_checkbox_toggled(self.active)

            MDLabel:
                id: checkbox_label
                text: "I have read and agree to the Terms & Conditions and Privacy Policy"
                theme_text_color: "Custom"
                font_style: "Body"
                role: "small"
                text_size: self.width, None
                valign: "middle"

        MDBoxLayout:
            size_hint_y: None
            height: dp(52)
            spacing: dp(12)

            MDButton:
                style: "tonal"
                size_hint_x: 1
                on_release: root.decline()

                MDButtonText:
                    text: "Decline"

            MDButton:
                id: agree_button
                style: "filled"
                size_hint_x: 1
                disabled: True
                on_release: root.agree()

                MDButtonText:
                    text: "I Agree"
