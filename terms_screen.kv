# terms_screen.kv
# Full-screen scrollable Terms & Conditions + checkbox + Agree/Decline.
# No back button -- this screen is a gate, not a normal navigable screen.
#
# root_layout has an explicit id so terms_screen.py can pad its
# bottom at runtime by the real Android gesture-nav-bar height (see
# theme/safe_area.py) -- otherwise Decline/I Agree can render
# partially or fully under the system gesture bar on Android 15+
# devices, where taps in that zone get consumed by the OS's
# back-swipe gesture instead of reaching the button.
#
# FIX: header_label/subtitle_label had no text_size and their box was
# a fixed dp(56) -- same overflow risk fixed elsewhere (calendar,
# checklist, timer, settings screens). checkbox_row was also a fixed
# dp(48), which clips checkbox_label (the longest text on this
# screen) if it wraps to two lines on a narrower phone -- switched to
# adaptive_height.

<TermsScreen>:

    MDBoxLayout:
        id: root_layout
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(14)

        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            adaptive_height: True

            MDLabel:
                id: header_label
                text: "Terms & Conditions"
                theme_text_color: "Custom"
                font_style: "Title"
                role: "medium"
                size_hint_y: None
                adaptive_height: True
                text_size: self.width, None

            MDLabel:
                id: subtitle_label
                text: "Please read before continuing"
                theme_text_color: "Custom"
                font_style: "Body"
                role: "small"
                size_hint_y: None
                adaptive_height: True
                text_size: self.width, None

        ScrollView:
            do_scroll_x: False

            MDLabel:
                id: terms_label
                text: ""
                theme_text_color: "Custom"
                font_style: "Body"
                role: "small"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                padding: dp(4), dp(8)

        MDBoxLayout:
            id: checkbox_row
            size_hint_y: None
            height: self.minimum_height
            adaptive_height: True
            spacing: dp(8)
            padding: 0, dp(6)

            MDCheckbox:
                id: agree_checkbox
                size_hint: None, None
                size: dp(32), dp(32)
                pos_hint: {"top": 1}
                on_active: root.on_checkbox_toggled(self.active)

            MDLabel:
                id: checkbox_label
                text: "I have read and agree to the Terms & Conditions and Privacy Policy"
                theme_text_color: "Custom"
                font_style: "Body"
                role: "small"
                size_hint_y: None
                adaptive_height: True
                text_size: self.width, None
                valign: "middle"

        MDBoxLayout:
            size_hint_y: None
            height: dp(52)
            spacing: dp(12)

            MDButton:
                style: "tonal"
                size_hint_x: 1
                on_release: root.decline()

                MDButtonText:
                    text: "Decline"

            MDButton:
                id: agree_button
                style: "filled"
                size_hint_x: 1
                # FIX: was `disabled: True` toggled via
                # on_checkbox_toggled. Toggling MDButton.disabled off
                # and back on was intermittently swallowing the first
                # tap(s) after re-enabling. agree() in the .py already
                # guards on agree_checkbox.active, so disabled was
                # redundant for correctness -- this now just dims the
                # button visually while leaving it always touchable.
                opacity: 1 if agree_checkbox.active else 0.5
                on_release: root.agree()

                MDButtonText:
                    text: "I Agree"