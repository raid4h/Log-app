#:kivy 2.3.1
#
# Detail screen for ONE checklist. Layout: header (back + tappable
# title/priority + edit pencil), a static "Your Tasks" section label,
# active items (with inline "+ Add another item" row at the bottom of
# the list), and a collapsible "N Checked Items" section -- both
# item_list and checked_section are filled entirely from Python
# (checklist_detail_screen.py), since item rows are dynamic
# ChecklistItem widgets with per-row delete buttons.
#
# UI-only pass: tightened section_label's bottom breathing room before
# item_list, and gave item_list slightly more spacing between rows so
# taller expanded items (with sub-items showing) don't read as
# crowded against their neighbors. The checkbox shape, expand-arrow
# visibility, and item/checkbox alignment are NOT fixable here -- they
# live in kv/checklist_item.kv (the ChecklistItem widget itself).

<ChecklistDetailScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20), dp(16), dp(20), dp(20)
        spacing: dp(18)

        # top bar: back + title/subtitle + edit icon
        MDBoxLayout:
            id: top_bar
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)

            MDIconButton:
                id: back_button
                icon: "arrow-left"
                theme_icon_color: "Custom"
                pos_hint: {"center_y": 0.5}
                on_release: root.go_back()

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(2)
                padding: dp(2), 0, 0, 0

                MDLabel:
                    id: header_label
                    text: ""
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    shorten: True
                    shorten_from: "right"

                MDLabel:
                    id: subtitle_label
                    text: ""
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"

            MDIconButton:
                icon: "pencil-outline"
                theme_icon_color: "Custom"
                pos_hint: {"center_y": 0.5}
                on_release: root.open_edit_checklist_popup()

        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False
            bar_width: dp(3)

            MDBoxLayout:
                id: content_column
                orientation: "vertical"
                spacing: dp(16)
                size_hint_y: None
                adaptive_height: True
                padding: 0, 0, 0, dp(12)

                MDLabel:
                    id: section_label
                    text: "Your Tasks"
                    theme_text_color: "Custom"
                    font_style: "Label"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    padding: [dp(2), 0]

                # active items + inline "add another item" row --
                # filled by ChecklistDetailScreen.load_items(). Spacing
                # bumped 12 -> 15dp so item rows have a bit more visual
                # separation, particularly when one item is taller than
                # its neighbors (e.g. subtasks expanded).
                MDBoxLayout:
                    id: item_list
                    orientation: "vertical"
                    spacing: dp(15)
                    size_hint_y: None
                    adaptive_height: True

                # thin divider before the checked-items section
                Widget:
                    size_hint_y: None
                    height: dp(1)
                    canvas:
                        Color:
                            rgba: root.theme_cls.outlineColor if hasattr(root, "theme_cls") else (0, 0, 0, 0.12)
                        Rectangle:
                            pos: self.x, self.center_y
                            size: self.width, dp(1)

                # collapsible "N Checked Items" header + list --
                # filled by ChecklistDetailScreen.load_items(); empty
                # (zero height) whenever there are no checked items
                MDBoxLayout:
                    id: checked_section
                    orientation: "vertical"
                    spacing: dp(10)
                    size_hint_y: None
                    adaptive_height: True