#:kivy 2.3.1
#
# Detail screen for ONE checklist. Layout: header (back + tappable
# title/priority + edit pencil), a static "Your Tasks" section label,
# active items (with inline "+ Add another item" row at the bottom of
# the list), and a collapsible "N Checked Items" section -- both
# item_list and checked_section are filled entirely from Python
# (checklist_detail_screen.py), since item rows are dynamic
# ChecklistItem widgets with per-row delete buttons.
#
# UI-only pass: back button top-aligned, title/subtitle nudged down
# via a small spacer (matching the same header fix already applied to
# Timer/Calendar), and the pencil button top-aligned to sit level with
# the title text instead of the row's vertical center.
#
# FIX: total_label (the running-total for shopping-list-style
# checklists) previously lived inside top_bar's fixed dp(64) title
# column, sharing space with header_label/subtitle_label -- as its
# height changed (items added/removed), the fixed box got squeezed
# and the title visibly shifted position. Moved here, into
# content_column (which is adaptive_height, not fixed), so it can
# grow/shrink freely without affecting the header at all.

<ChecklistDetailScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20), dp(16), dp(20), dp(20)
        spacing: dp(18)

        # top bar: back + title/subtitle + edit icon
        MDBoxLayout:
            id: top_bar
            size_hint_y: None
            height: dp(64)
            spacing: dp(10)

            MDIconButton:
                id: back_button
                icon: "arrow-left"
                theme_icon_color: "Custom"
                pos_hint: {"top": 1}
                on_release: root.go_back()

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(2)
                padding: dp(2), 0, 0, 0
                pos_hint: {"top": 1}

                Widget:
                    size_hint_y: None
                    height: dp(10)

                MDLabel:
                    id: header_label
                    text: ""
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    shorten: True
                    shorten_from: "right"

                MDLabel:
                    id: subtitle_label
                    text: ""
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"

            MDIconButton:
                icon: "pencil-outline"
                theme_icon_color: "Custom"
                pos_hint: {"top": 1}
                on_release: root.open_edit_checklist_popup()

        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False
            bar_width: dp(3)

            MDBoxLayout:
                id: content_column
                orientation: "vertical"
                spacing: dp(16)
                size_hint_y: None
                adaptive_height: True
                padding: 0, 0, 0, dp(12)

                MDLabel:
                    id: section_label
                    text: "Your Tasks"
                    theme_text_color: "Custom"
                    font_style: "Label"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    padding: [dp(2), 0]

                MDLabel:
                    id: total_label
                    text: ""
                    theme_text_color: "Custom"
                    font_style: "Label"
                    role: "large"
                    bold: True
                    size_hint_y: None
                    height: 0
                    text_size: self.width, None
                    padding: [dp(2), dp(2)]

                MDBoxLayout:
                    id: item_list
                    orientation: "vertical"
                    spacing: dp(15)
                    size_hint_y: None
                    adaptive_height: True

                Widget:
                    size_hint_y: None
                    height: dp(1)
                    canvas:
                        Color:
                            rgba: root.theme_cls.outlineColor if hasattr(root, "theme_cls") else (0, 0, 0, 0.12)
                        Rectangle:
                            pos: self.x, self.center_y
                            size: self.width, dp(1)

                MDBoxLayout:
                    id: checked_section
                    orientation: "vertical"
                    spacing: dp(10)
                    size_hint_y: None
                    adaptive_height: True