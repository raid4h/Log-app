<HomeScreen>:
    FloatLayout:
        # ================================================================
        # HOME CONTENT
        # ================================================================

        ScrollView:
            id: home_scroll
            size_hint: 1, 1
            bar_width: 0
            scroll_type: ["content"]
            do_scroll_x: False

            MDBoxLayout:
                id: drawer_layout
                orientation: "vertical"
                size_hint_y: None
                adaptive_height: True
                padding: dp(24), dp(18), dp(24), dp(30)
                spacing: dp(16)

                # ========================================================
                # HEADER
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(74)
                    spacing: dp(12)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)
                        size_hint_x: 1
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: greeting_label
                            text: "Good afternoon"
                            font_style: "Title"
                            role: "large"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                        MDLabel:
                            id: date_label
                            text: "Saturday, 15 August"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True

                    MDIconButton:
                        id: menu_button
                        icon: "menu"
                        theme_icon_color: "Custom"
                        icon_color: root.header_text_color
                        size_hint: None, None
                        size: dp(46), dp(46)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.open_settings()

                # ========================================================
                # QUICK ACTIONS
                # ========================================================

                MDBoxLayout:
                    id: quick_actions
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(100)
                    spacing: dp(9)

                    # NOTE
                    QuickAction:
                        id: notes_quick_card
                        orientation: "vertical"
                        spacing: dp(7)
                        size_hint_x: 0.25
                        padding: dp(7)
                        on_release: app.root.get_screen("home").open_notes()

                        MDCard:
                            size_hint: 1, None
                            height: dp(62)
                            radius: [20]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_note_bg
                            on_release: app.root.get_screen("home").open_notes()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDCard:
                                    size_hint: None, None
                                    size: dp(42), dp(42)
                                    radius: [15]
                                    elevation: 0
                                    theme_bg_color: "Custom"
                                    md_bg_color: root.card_primary_color
                                    on_release: app.root.get_screen("home").open_notes()

                                    AnchorLayout:
                                        anchor_x: "center"
                                        anchor_y: "center"

                                        MDIcon:
                                            icon: "note-text-outline"
                                            theme_text_color: "Custom"
                                            text_color: root.header_accent_color
                                            size_hint: None, None
                                            size: dp(24), dp(24)

                        MDLabel:
                            text: "Note"
                            font_style: "Label"
                            role: "small"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                    # CHECKLIST
                    QuickAction:
                        id: checklist_quick_card
                        orientation: "vertical"
                        spacing: dp(7)
                        size_hint_x: 0.25
                        padding: dp(7)
                        on_release: app.root.get_screen("home").open_checklist()

                        MDCard:
                            size_hint: 1, None
                            height: dp(62)
                            radius: [20]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_checklist_bg
                            on_release: app.root.get_screen("home").open_checklist()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDCard:
                                    size_hint: None, None
                                    size: dp(42), dp(42)
                                    radius: [15]
                                    elevation: 0
                                    theme_bg_color: "Custom"
                                    md_bg_color: root.card_primary_color
                                    on_release: app.root.get_screen("home").open_checklist()

                                    AnchorLayout:
                                        anchor_x: "center"
                                        anchor_y: "center"

                                        MDIcon:
                                            icon: "checkbox-marked-outline"
                                            theme_text_color: "Custom"
                                            text_color: root.tile_accent_tasks_color
                                            size_hint: None, None
                                            size: dp(24), dp(24)

                        MDLabel:
                            text: "Checklist"
                            font_style: "Label"
                            role: "small"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                    # EVENT
                    QuickAction:
                        id: event_quick_action
                        orientation: "vertical"
                        spacing: dp(7)
                        size_hint_x: 0.25
                        padding: dp(7)
                        on_release: app.root.get_screen("home").route_quick_add("event")

                        MDCard:
                            size_hint: 1, None
                            height: dp(62)
                            radius: [20]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_event_bg
                            on_release: app.root.get_screen("home").route_quick_add("event")

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDCard:
                                    size_hint: None, None
                                    size: dp(42), dp(42)
                                    radius: [15]
                                    elevation: 0
                                    theme_bg_color: "Custom"
                                    md_bg_color: root.card_primary_color
                                    on_release: app.root.get_screen("home").route_quick_add("event")

                                    AnchorLayout:
                                        anchor_x: "center"
                                        anchor_y: "center"

                                        MDIcon:
                                            icon: "calendar-outline"
                                            theme_text_color: "Custom"
                                            text_color: root.event_icon_color
                                            size_hint: None, None
                                            size: dp(24), dp(24)

                        MDLabel:
                            text: "Event"
                            font_style: "Label"
                            role: "small"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                    # FOCUS
                    QuickAction:
                        id: focus_quick_action
                        orientation: "vertical"
                        spacing: dp(7)
                        size_hint_x: 0.25
                        padding: dp(7)
                        on_release: app.root.get_screen("home").open_study_session_popup()

                        MDCard:
                            size_hint: 1, None
                            height: dp(62)
                            radius: [20]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_focus_bg
                            on_release: app.root.get_screen("home").open_study_session_popup()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDCard:
                                    size_hint: None, None
                                    size: dp(42), dp(42)
                                    radius: [15]
                                    elevation: 0
                                    theme_bg_color: "Custom"
                                    md_bg_color: root.card_primary_color
                                    on_release: app.root.get_screen("home").open_study_session_popup()

                                    AnchorLayout:
                                        anchor_x: "center"
                                        anchor_y: "center"

                                        MDIcon:
                                            icon: "timer-outline"
                                            theme_text_color: "Custom"
                                            text_color: root.tile_accent_pomodoro_color
                                            size_hint: None, None
                                            size: dp(24), dp(24)

                        MDLabel:
                            text: "Focus"
                            font_style: "Label"
                            role: "small"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                # ========================================================
                # TODAY
                # ========================================================

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(3)
                    padding: 0, dp(4), 0, dp(2)

                    MDLabel:
                        id: today_section_label
                        text: "TODAY  ✦"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True

                    MDLabel:
                        id: today_summary_title
                        text: "Let's make it a productive day!"
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_text_color
                        adaptive_height: True

                    MDLabel:
                        id: today_summary_stats
                        text: ""
                        font_style: "Body"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(6)
                        padding: 0, dp(4), 0, 0

                        MDCard:
                            size_hint: 1, 1
                            radius: [3]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.border_color

                            FloatLayout:

                                MDCard:
                                    id: summary_bar
                                    size_hint: 0, 1
                                    pos_hint: {"x": 0, "center_y": 0.5}
                                    radius: [3]
                                    elevation: 0
                                    theme_bg_color: "Custom"
                                    md_bg_color: root.header_accent_color

                # ========================================================
                # TODAY STATS
                # ========================================================

                MDCard:
                    id: today_stats_card
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(82)
                    padding: dp(10), dp(8)
                    spacing: dp(4)
                    radius: [20]
                    elevation: 1
                    shadow_softness: 6
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_x: 0.33

                        MDCard:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [14]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.stats_tasks_bg
                            pos_hint: {"center_y": 0.5}

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "check-circle-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.tile_accent_pomodoro_color
                                    size_hint: None, None
                                    size: dp(22), dp(22)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(0)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: stat_tasks
                                text: "0"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True

                            MDLabel:
                                text: "Tasks"
                                font_style: "Label"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_x: None
                        width: dp(1)
                        padding: 0, dp(10)

                        MDCard:
                            size_hint: 1, 1
                            radius: [1]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.border_color

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_x: 0.33

                        MDCard:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [14]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.stats_notes_bg
                            pos_hint: {"center_y": 0.5}

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "notebook-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.tile_accent_tasks_color
                                    size_hint: None, None
                                    size: dp(22), dp(22)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(0)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: stat_notes
                                text: "0"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True

                            MDLabel:
                                text: "Notes"
                                font_style: "Label"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_x: None
                        width: dp(1)
                        padding: 0, dp(10)

                        MDCard:
                            size_hint: 1, 1
                            radius: [1]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.border_color

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_x: 0.33

                        MDCard:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [14]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.stats_focus_bg
                            pos_hint: {"center_y": 0.5}

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "timer-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.header_accent_color
                                    size_hint: None, None
                                    size: dp(22), dp(22)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(0)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: stat_focus
                                text: "0"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True

                            MDLabel:
                                text: "Focus"
                                font_style: "Label"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True

                # ========================================================
                # NEXT UP
                # ========================================================

                MDLabel:
                    id: next_up_label
                    text: "UP NEXT  ✦"
                    font_style: "Label"
                    role: "medium"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: root.header_secondary_color
                    adaptive_height: True
                    padding_y: dp(4)

                MDCard:
                    id: next_up_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color
                    radius: [22]
                    elevation: 1
                    shadow_softness: 8
                    shadow_offset: (0, -2)
                    ripple_behavior: True
                    size_hint_y: None
                    height: dp(104)
                    padding: dp(12)

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(12)

                        MDCard:
                            size_hint: None, None
                            size: dp(58), dp(58)
                            radius: [18]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_focus_bg
                            pos_hint: {"center_y": 0.5}

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    id: next_up_icon
                                    icon: "calendar-clock-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.tile_accent_pomodoro_color
                                    size_hint: None, None
                                    size: dp(30), dp(30)
                                    halign: "center"
                                    valign: "middle"

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)
                            size_hint_x: 1
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: next_up_title
                                text: "Nothing scheduled"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                            MDLabel:
                                id: next_up_subtitle
                                text: "Your schedule is clear"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(58)
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: next_up_number
                                text: ""
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                theme_font_size: "Custom"
                                font_size: sp(25)
                                bold: True
                                adaptive_height: True

                            MDLabel:
                                id: next_up_unit
                                text: ""
                                halign: "center"
                                font_style: "Label"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True

                # ========================================================
                # TODAY'S LOG
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(28)
                    padding: 0, dp(4), 0, 0

                    MDLabel:
                        id: todays_log_label
                        text: "TODAY'S LOG"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True

                    MDLabel:
                        id: today_count_label
                        text: ""
                        halign: "right"
                        font_style: "Body"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True

                MDCard:
                    id: today_plan_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color
                    radius: [22]
                    elevation: 1
                    shadow_softness: 8
                    size_hint_y: None
                    height: self.minimum_height + dp(12)
                    padding: dp(8)

                    MDBoxLayout:
                        id: today_plan_list
                        orientation: "vertical"
                        spacing: dp(2)
                        size_hint_y: None
                        adaptive_height: True

                Widget:
                    size_hint_y: None
                    height: dp(14)
