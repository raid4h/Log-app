<HomeScreen>:
    FloatLayout:

        ScrollView:
            id: home_scroll
            size_hint: 1, 1
            bar_width: 0
            scroll_type: ["content"]
            do_scroll_x: False

            MDBoxLayout:
                id: drawer_layout
                orientation: "vertical"
                size_hint_y: None
                adaptive_height: True
                padding: dp(30), dp(22), dp(30), dp(28)
                spacing: dp(18)

                # ========================================================
                # HEADER
                # ========================================================
                # FIX: replaced the time-of-day greeting ("Good
                # afternoon" + date) with a static app title + tagline,
                # per the new home screen layout. menu_button restyled
                # from a hamburger to a gear icon -- same
                # open_settings() call, no logic change.

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(64)
                    spacing: dp(12)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(3)
                        size_hint_x: 1
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: app_title_label
                            text: "Log"
                            font_style: "Title"
                            role: "large"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                        MDLabel:
                            id: tagline_label
                            text: "Small steps. Big days."
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True

                    MDIconButton:
                        id: menu_button
                        icon: "cog-outline"
                        theme_icon_color: "Custom"
                        icon_color: root.header_text_color
                        size_hint: None, None
                        size: dp(44), dp(44)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.open_settings()

                # ========================================================
                # FEATURE CARDS: Calendar / Checklist / Notes
                # ========================================================
                # FIX: replaced the single full-width "Checklist" quick
                # action with a 3-up row (Calendar, Checklist, Notes),
                # each its own tinted card -- Timer is gone, so this is
                # a clean three-way split rather than reusing the old
                # single-row layout.

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(148)
                    spacing: dp(12)

                    # -- Calendar --
                    MDCard:
                        theme_bg_color: "Custom"
                        md_bg_color: root.quick_event_bg
                        radius: [20]
                        elevation: 1
                        shadow_softness: 10
                        shadow_offset: (0, -1)
                        ripple_behavior: True
                        size_hint_x: 1
                        padding: dp(14)
                        on_release: app.root.get_screen("home").open_calendar()

                        QuickAction:
                            orientation: "vertical"
                            spacing: dp(6)
                            on_release: app.root.get_screen("home").open_calendar()

                            MDIcon:
                                icon: "calendar-outline"
                                theme_text_color: "Custom"
                                text_color: root.event_icon_color
                                size_hint: None, None
                                size: dp(30), dp(30)

                            Widget:
                                size_hint_y: 1

                            MDBoxLayout:
                                orientation: "horizontal"
                                size_hint_y: None
                                height: dp(22)
                                spacing: dp(2)

                                MDLabel:
                                    text: "Calendar"
                                    font_style: "Title"
                                    role: "small"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    adaptive_height: True
                                    shorten: True
                                    shorten_from: "right"

                                MDIcon:
                                    icon: "chevron-right"
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    size_hint: None, None
                                    size: dp(16), dp(16)
                                    pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "View your dates and plans"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                    # -- Checklist --
                    MDCard:
                        theme_bg_color: "Custom"
                        md_bg_color: root.quick_checklist_bg
                        radius: [20]
                        elevation: 1
                        shadow_softness: 10
                        shadow_offset: (0, -1)
                        ripple_behavior: True
                        size_hint_x: 1
                        padding: dp(14)
                        on_release: app.root.get_screen("home").open_checklist()

                        QuickAction:
                            orientation: "vertical"
                            spacing: dp(6)
                            on_release: app.root.get_screen("home").open_checklist()

                            MDIcon:
                                icon: "checkbox-marked-outline"
                                theme_text_color: "Custom"
                                text_color: root.tile_accent_tasks_color
                                size_hint: None, None
                                size: dp(30), dp(30)

                            Widget:
                                size_hint_y: 1

                            MDBoxLayout:
                                orientation: "horizontal"
                                size_hint_y: None
                                height: dp(22)
                                spacing: dp(2)

                                MDLabel:
                                    text: "Checklist"
                                    font_style: "Title"
                                    role: "small"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    adaptive_height: True
                                    shorten: True
                                    shorten_from: "right"

                                MDIcon:
                                    icon: "chevron-right"
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    size_hint: None, None
                                    size: dp(16), dp(16)
                                    pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Track your tasks"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                                        # -- Notes --
                    MDCard:
                        theme_bg_color: "Custom"
                        md_bg_color: root.quick_note_bg
                        radius: [20]
                        elevation: 1
                        shadow_softness: 10
                        shadow_offset: (0, -1)
                        ripple_behavior: True
                        size_hint_x: 1
                        padding: dp(14)
                        on_release: app.root.get_screen("home").open_notes_list()

                        QuickAction:
                            orientation: "vertical"
                            spacing: dp(6)
                            on_release: app.root.get_screen("home").open_notes_list()


                            MDIcon:
                                icon: "note-text-outline"
                                theme_text_color: "Custom"
                                text_color: root.header_accent_color
                                size_hint: None, None
                                size: dp(30), dp(30)

                            Widget:
                                size_hint_y: 1

                            MDBoxLayout:
                                orientation: "horizontal"
                                size_hint_y: None
                                height: dp(22)
                                spacing: dp(2)

                                MDLabel:
                                    text: "Notes"
                                    font_style: "Title"
                                    role: "small"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    adaptive_height: True
                                    shorten: True
                                    shorten_from: "right"

                                MDIcon:
                                    icon: "chevron-right"
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    size_hint: None, None
                                    size: dp(16), dp(16)
                                    pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Capture your thoughts"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                # ========================================================
                # UP NEXT -- unchanged
                # ========================================================

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(24)

                    MDLabel:
                        id: next_up_label
                        text: "UP NEXT"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                MDCard:
                    id: next_up_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_secondary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    ripple_behavior: True
                    size_hint_y: None
                    height: dp(98)
                    padding: dp(14)

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(14)

                        MDCard:
                            size_hint: None, None
                            size: dp(58), dp(58)
                            radius: [18]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_event_bg
                            pos_hint: {"center_y": 0.5}

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    id: next_up_icon
                                    icon: "calendar-clock-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.event_icon_color
                                    size_hint: None, None
                                    size: dp(29), dp(29)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(3)
                            size_hint_x: 1
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: next_up_title
                                text: "Nothing scheduled"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                            MDLabel:
                                id: next_up_subtitle
                                text: "Your schedule is clear"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(62)
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(-2)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: next_up_number
                                text: ""
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                theme_font_size: "Custom"
                                font_size: sp(27)
                                bold: True
                                size_hint_y: None
                                height: dp(31)

                            MDLabel:
                                id: next_up_unit
                                text: ""
                                halign: "center"
                                font_style: "Label"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                size_hint_y: None
                                height: dp(15)

                # ========================================================
                # TODAY'S LOG -- unchanged
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(28)

                    MDLabel:
                        id: todays_log_label
                        text: "TODAY'S LOG"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        id: today_count_label
                        text: ""
                        halign: "right"
                        font_style: "Body"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                MDCard:
                    id: today_plan_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    size_hint_y: None
                    height: self.minimum_height + dp(16)
                    padding: dp(10)

                    MDBoxLayout:
                        id: today_plan_list
                        orientation: "vertical"
                        spacing: dp(2)
                        size_hint_y: None
                        adaptive_height: True

                Widget:
                    size_hint_y: None
                    height: dp(18)