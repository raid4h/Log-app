<HomeScreen>:
    FloatLayout:

        ScrollView:
            id: home_scroll
            size_hint: 1, 1
            bar_width: 0
            scroll_type: ["content"]
            do_scroll_x: False

            MDBoxLayout:
                id: drawer_layout
                orientation: "vertical"
                size_hint_y: None
                adaptive_height: True
                padding: dp(30), dp(22), dp(30), dp(28)
                spacing: dp(18)

                # ========================================================
                # HEADER
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(64)
                    spacing: dp(12)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(3)
                        size_hint_x: 1
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: app_title_label
                            text: "Log"
                            font_style: "Title"
                            role: "large"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                        MDLabel:
                            id: tagline_label
                            text: "Small steps. Big days."
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True

                    MDIconButton:
                        id: menu_button
                        icon: "cog-outline"
                        theme_icon_color: "Custom"
                        icon_color: root.header_text_color
                        size_hint: None, None
                        size: dp(44), dp(44)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.open_settings()

                # ========================================================
                # FEATURE CARDS: Calendar / Checklist / Notes
                # ========================================================
                # FIX: cards restructured to be small, roughly-square
                # icon-only tiles, matching the reference layout --
                # title+chevron and subtitle now live BELOW each card
                # as separate labels, not inside the card itself. The
                # whole column (card + labels) is wrapped in one
                # QuickAction so tapping anywhere in the column --
                # icon or text -- navigates, not just the icon tile.

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(150)
                    spacing: dp(12)

                    # -- Calendar --
                    QuickAction:
                        orientation: "vertical"
                        spacing: dp(6)
                        size_hint_x: 1
                        on_release: app.root.get_screen("home").open_calendar()

                        MDCard:
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_event_bg
                            radius: [18]
                            elevation: 1
                            shadow_softness: 10
                            shadow_offset: (0, -1)
                            ripple_behavior: True
                            size_hint_y: None
                            height: dp(76)
                            on_release: app.root.get_screen("home").open_calendar()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "calendar-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.event_icon_color
                                    size_hint: None, None
                                    size: dp(30), dp(30)

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(22)
                            spacing: dp(2)

                            MDLabel:
                                text: "Calendar"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                            MDIcon:
                                icon: "chevron-right"
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                size_hint: None, None
                                size: dp(16), dp(16)
                                pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "View your dates and plans"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"

                    # -- Checklist --
                    QuickAction:
                        orientation: "vertical"
                        spacing: dp(6)
                        size_hint_x: 1
                        on_release: app.root.get_screen("home").open_checklist()

                        MDCard:
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_checklist_bg
                            radius: [18]
                            elevation: 1
                            shadow_softness: 10
                            shadow_offset: (0, -1)
                            ripple_behavior: True
                            size_hint_y: None
                            height: dp(76)
                            on_release: app.root.get_screen("home").open_checklist()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "checkbox-marked-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.tile_accent_tasks_color
                                    size_hint: None, None
                                    size: dp(30), dp(30)

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(22)
                            spacing: dp(2)

                            MDLabel:
                                text: "Checklist"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                            MDIcon:
                                icon: "chevron-right"
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                size_hint: None, None
                                size: dp(16), dp(16)
                                pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Track your tasks"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"

                    # -- Notes --
                    QuickAction:
                        orientation: "vertical"
                        spacing: dp(6)
                        size_hint_x: 1
                        on_release: app.root.get_screen("home").open_notes_list()

                        MDCard:
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_note_bg
                            radius: [18]
                            elevation: 1
                            shadow_softness: 10
                            shadow_offset: (0, -1)
                            ripple_behavior: True
                            size_hint_y: None
                            height: dp(76)
                            on_release: app.root.get_screen("home").open_notes_list()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "note-text-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.header_accent_color
                                    size_hint: None, None
                                    size: dp(30), dp(30)

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(22)
                            spacing: dp(2)

                            MDLabel:
                                text: "Notes"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                            MDIcon:
                                icon: "chevron-right"
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                size_hint: None, None
                                size: dp(16), dp(16)
                                pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Capture your thoughts"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"

                                # ========================================================
                # UP NEXT
                # ========================================================
                # FIX: restructured to match Today's Log's empty-state
                # layout exactly -- icon on its own line, then title,
                # then subtitle, stacked vertically, instead of the
                # previous icon-box-beside-text horizontal layout. This
                # is what actually made the two sections visually
                # inconsistent, not just the (already-removed) ripple
                # behavior. The number/unit countdown (next_up_number/
                # next_up_unit) is kept but moved to sit alongside the
                # title on the same row, since dropping it entirely
                # would lose real information the card provides.

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(24)

                    MDLabel:
                        id: next_up_label
                        text: "UP NEXT"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                MDCard:
                    id: next_up_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_secondary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(20), dp(18)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(6)
                        size_hint_y: None
                        adaptive_height: True

                        MDIcon:
                            id: next_up_icon
                            icon: "calendar-clock-outline"
                            theme_text_color: "Custom"
                            text_color: root.event_icon_color
                            size_hint: None, None
                            size: dp(28), dp(28)

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            adaptive_height: True
                            spacing: dp(8)

                            MDLabel:
                                id: next_up_title
                                text: "Nothing scheduled"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                size_hint_x: 1
                                shorten: True
                                shorten_from: "right"

                            MDBoxLayout:
                                orientation: "horizontal"
                                size_hint_x: None
                                adaptive_width: True
                                spacing: dp(2)

                                MDLabel:
                                    id: next_up_number
                                    text: ""
                                    theme_text_color: "Custom"
                                    text_color: root.header_text_color
                                    bold: True
                                    font_style: "Title"
                                    role: "small"
                                    adaptive_height: True
                                    adaptive_width: True

                                MDLabel:
                                    id: next_up_unit
                                    text: ""
                                    font_style: "Body"
                                    role: "small"
                                    theme_text_color: "Custom"
                                    text_color: root.header_secondary_color
                                    adaptive_height: True
                                    adaptive_width: True

                        MDLabel:
                            id: next_up_subtitle
                            text: "Your schedule is clear"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True
                            shorten: True
                            shorten_from: "right"

                # ========================================================
                # TODAY'S LOG -- unchanged
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(28)

                    MDLabel:
                        id: todays_log_label
                        text: "TODAY'S LOG"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        id: today_count_label
                        text: ""
                        halign: "right"
                        font_style: "Body"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                MDCard:
                    id: today_plan_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    size_hint_y: None
                    height: self.minimum_height + dp(16)
                    padding: dp(10)

                    MDBoxLayout:
                        id: today_plan_list
                        orientation: "vertical"
                        spacing: dp(2)
                        size_hint_y: None
                        adaptive_height: True

                Widget:
                    size_hint_y: None
                    height: dp(18)