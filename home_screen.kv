<HomeScreen>:
    FloatLayout:

        ScrollView:
            id: home_scroll
            size_hint: 1, 1
            bar_width: 0
            scroll_type: ["content"]
            do_scroll_x: False

            MDBoxLayout:
                id: drawer_layout
                orientation: "vertical"
                size_hint_y: None
                adaptive_height: True
                padding: dp(30), dp(22), dp(30), dp(28)
                spacing: dp(18)

                # ========================================================
                # HEADER
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(72)
                    spacing: dp(12)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(3)
                        size_hint_x: 1
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: greeting_label
                            text: "Good afternoon"
                            font_style: "Title"
                            role: "large"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: root.header_text_color
                            adaptive_height: True

                        MDLabel:
                            id: date_label
                            text: "Saturday, 15 August"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: root.header_secondary_color
                            adaptive_height: True

                    MDIconButton:
                        id: menu_button
                        icon: "menu"
                        theme_icon_color: "Custom"
                        icon_color: root.header_text_color
                        size_hint: None, None
                        size: dp(44), dp(44)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.open_settings()

                # ========================================================
                # CHECKLIST QUICK ACTION
                # ========================================================

                MDCard:
                    id: checklist_quick_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    ripple_behavior: True
                    size_hint_y: None
                    height: dp(82)
                    padding: dp(14)
                    on_release: app.root.get_screen("home").open_checklist()

                    QuickAction:
                        orientation: "horizontal"
                        spacing: dp(14)
                        on_release: app.root.get_screen("home").open_checklist()

                        MDCard:
                            size_hint: None, None
                            size: dp(54), dp(54)
                            radius: [16]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_checklist_bg
                            pos_hint: {"center_y": 0.5}
                            on_release: app.root.get_screen("home").open_checklist()

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    icon: "checkbox-marked-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.tile_accent_tasks_color
                                    size_hint: None, None
                                    size: dp(27), dp(27)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)
                            size_hint_x: 1
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Checklist"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True

                            MDLabel:
                                text: "View and manage your tasks"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                        AnchorLayout:
                            size_hint: None, 1
                            width: dp(26)
                            anchor_x: "center"
                            anchor_y: "center"

                            MDIcon:
                                icon: "chevron-right"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                size_hint: None, None
                                size: dp(22), dp(22)

                # ========================================================
                # UP NEXT
                # ========================================================

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(24)

                    MDLabel:
                        id: next_up_label
                        text: "UP NEXT"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                MDCard:
                    id: next_up_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_secondary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    ripple_behavior: True
                    size_hint_y: None
                    height: dp(98)
                    padding: dp(14)

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(14)

                        MDCard:
                            size_hint: None, None
                            size: dp(58), dp(58)
                            radius: [18]
                            elevation: 0
                            theme_bg_color: "Custom"
                            md_bg_color: root.quick_focus_bg
                            pos_hint: {"center_y": 0.5}

                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "center"

                                MDIcon:
                                    id: next_up_icon
                                    icon: "calendar-clock-outline"
                                    theme_text_color: "Custom"
                                    text_color: root.tile_accent_pomodoro_color
                                    size_hint: None, None
                                    size: dp(29), dp(29)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(3)
                            size_hint_x: 1
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: next_up_title
                                text: "Nothing scheduled"
                                font_style: "Title"
                                role: "small"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                            MDLabel:
                                id: next_up_subtitle
                                text: "Your schedule is clear"
                                font_style: "Body"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(62)
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(-2)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: next_up_number
                                text: ""
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: root.header_text_color
                                theme_font_size: "Custom"
                                font_size: sp(27)
                                bold: True
                                size_hint_y: None
                                height: dp(31)

                            MDLabel:
                                id: next_up_unit
                                text: ""
                                halign: "center"
                                font_style: "Label"
                                role: "small"
                                theme_text_color: "Custom"
                                text_color: root.header_secondary_color
                                size_hint_y: None
                                height: dp(15)

                # ========================================================
                # TODAY'S LOG
                # ========================================================

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(28)

                    MDLabel:
                        id: todays_log_label
                        text: "TODAY'S LOG"
                        font_style: "Label"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        id: today_count_label
                        text: ""
                        halign: "right"
                        font_style: "Body"
                        role: "small"
                        theme_text_color: "Custom"
                        text_color: root.header_secondary_color
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                MDCard:
                    id: today_plan_card
                    theme_bg_color: "Custom"
                    md_bg_color: root.card_primary_color
                    radius: [20]
                    elevation: 1
                    shadow_softness: 10
                    shadow_offset: (0, -1)
                    size_hint_y: None
                    height: self.minimum_height + dp(16)
                    padding: dp(10)

                    MDBoxLayout:
                        id: today_plan_list
                        orientation: "vertical"
                        spacing: dp(2)
                        size_hint_y: None
                        adaptive_height: True

                Widget:
                    size_hint_y: None
                    height: dp(18)
