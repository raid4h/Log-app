<SettingsScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        # top row: back arrow + title/subtitle
        MDBoxLayout:
            size_hint_y: None
            height: self.minimum_height
            adaptive_height: True
            spacing: dp(8)

            MDIconButton:
                id: back_button
                icon: "arrow-left"
                theme_icon_color: "Custom"
                pos_hint: {"top": 1}
                on_release: root.go_back()

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                adaptive_height: True

                MDLabel:
                    id: title_label
                    text: "Settings"
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "medium"
                    size_hint_y: None
                    adaptive_height: True
                    text_size: self.width, None

                MDLabel:
                    id: subtitle_label
                    text: "Customize your Log experience"
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    adaptive_height: True
                    text_size: self.width, None

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(16)
                adaptive_height: True

                # ── theme card ──
                MDCard:
                    id: theme_card
                    theme_bg_color: "Custom"
                    md_bg_color: 0, 0, 0, 0
                    elevation: 0
                    theme_shadow_color: "Custom"
                    shadow_color: 0, 0, 0, 0
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(12)
                    adaptive_height: True
                    radius: [16]

                    MDLabel:
                        id: theme_section_label
                        text: "Theme"
                        theme_text_color: "Custom"
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                        text_size: self.width, None

                    ScrollView:
                        size_hint_y: None
                        height: dp(48)
                        do_scroll_x: True
                        do_scroll_y: False
                        bar_width: dp(0)

                        MDBoxLayout:
                            size_hint_x: None
                            width: self.minimum_width
                            spacing: dp(8)
                            padding: dp(2), 0

                            MDButton:
                                id: default_button
                                style: "filled"
                                on_release: root.set_default_theme()
                                MDButtonText:
                                    text: "Default"

                            MDButton:
                                id: dark_button
                                style: "filled"
                                on_release: root.set_dark_theme()
                                MDButtonText:
                                    text: "Dark"

                            MDButton:
                                id: floral_button
                                style: "filled"
                                on_release: root.set_floral_theme()
                                MDButtonText:
                                    text: "Floral"

                            MDButton:
                                id: matcha_button
                                style: "filled"
                                on_release: root.set_matcha_theme()
                                MDButtonText:
                                    text: "Matcha"

                            MDButton:
                                id: monochrome_button
                                style: "filled"
                                on_release: root.set_monochrome_theme()
                                MDButtonText:
                                    text: "Monochrome"

                # ── backup & restore card: folder export/import ──
                MDCard:
                    id: backup_card
                    theme_bg_color: "Custom"
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(14)
                    adaptive_height: True
                    radius: [16]

                    MDLabel:
                        id: backup_section_label
                        text: "Backup & Restore"
                        theme_text_color: "Custom"
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                        text_size: self.width, None

                    # -- export row --
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)

                        MDLabel:
                            id: export_row_label
                            text: "Export to folder"
                            theme_text_color: "Custom"
                            font_style: "Title"
                            role: "small"
                            shorten: True
                            shorten_from: "right"
                            text_size: self.width, None

                        MDIconButton:
                            id: export_chevron
                            icon: "chevron-right"
                            theme_icon_color: "Custom"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.export_to_file()

                    # -- import row --
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)

                        MDLabel:
                            id: import_row_label
                            text: "Import from folder"
                            theme_text_color: "Custom"
                            font_style: "Title"
                            role: "small"
                            shorten: True
                            shorten_from: "right"
                            text_size: self.width, None

                        MDIconButton:
                            id: import_chevron
                            icon: "chevron-right"
                            theme_icon_color: "Custom"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.import_from_file()

                # ── privacy card ──
                MDCard:
                    id: privacy_card
                    theme_bg_color: "Custom"
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(12)
                    adaptive_height: True
                    radius: [16]

                    MDLabel:
                        id: privacy_section_label
                        text: "Privacy"
                        theme_text_color: "Custom"
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                        text_size: self.width, None

                    MDBoxLayout:
                        size_hint_y: None
                        height: self.minimum_height
                        adaptive_height: True
                        spacing: dp(8)

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1
                            size_hint_y: None
                            adaptive_height: True

                            MDLabel:
                                id: privacy_row_label
                                text: "Privacy settings"
                                theme_text_color: "Custom"
                                font_style: "Title"
                                role: "small"
                                adaptive_height: True
                                text_size: self.width, None

                            MDLabel:
                                id: privacy_row_subtitle
                                text: "Manage app permissions and data"
                                theme_text_color: "Custom"
                                font_style: "Body"
                                role: "small"
                                adaptive_height: True
                                text_size: self.width, None

                        MDIconButton:
                            id: privacy_chevron
                            icon: "chevron-right"
                            theme_icon_color: "Custom"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.open_privacy_settings()

                # ── notifications card ──
                MDCard:
                    id: notifications_card
                    theme_bg_color: "Custom"
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(12)
                    adaptive_height: True
                    radius: [16]

                    MDLabel:
                        id: notifications_section_label
                        text: "Notifications"
                        theme_text_color: "Custom"
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                        text_size: self.width, None

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)

                        MDLabel:
                            id: notifications_row_label
                            text: "Enable notifications"
                            theme_text_color: "Custom"
                            font_style: "Title"
                            role: "small"
                            shorten: True
                            shorten_from: "right"
                            text_size: self.width, None

                        MDSwitch:
                            pos_hint: {"center_y": 0.5}
                            on_active: root.toggle_notifications()

                # ── about card ──
                MDCard:
                    id: about_card
                    theme_bg_color: "Custom"
                    orientation: "vertical"
                    padding: dp(16)
                    spacing: dp(12)
                    adaptive_height: True
                    radius: [16]

                    MDLabel:
                        id: about_section_label
                        text: "About Log"
                        theme_text_color: "Custom"
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                        text_size: self.width, None

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)

                        MDLabel:
                            id: privacy_policy_row_label
                            text: "Privacy policy"
                            theme_text_color: "Custom"
                            font_style: "Title"
                            role: "small"
                            shorten: True
                            shorten_from: "right"
                            text_size: self.width, None

                        MDIconButton:
                            id: privacy_policy_chevron
                            icon: "chevron-right"
                            theme_icon_color: "Custom"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.open_privacy_policy()

                    MDLabel:
                        id: footer_label
                        text: "CSE299(10) Group 3, Summer 2026"
                        theme_text_color: "Custom"
                        font_style: "Body"
                        role: "small"
                        adaptive_height: True
                        text_size: self.width, None