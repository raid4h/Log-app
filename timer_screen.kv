# timer_screen.kv
# Modern Pomodoro UI. All colors are applied from timer_screen.py via
# ThemeManager + THEME_MAP / on_theme_applied — nothing here is hardcoded.
#
# FIX: header_label/subtitle_label had no text_size, and top_bar was a
# fixed dp(64) -- on a narrow phone screen a wrapped subtitle would
# overflow the header, same issue fixed in calendar_screen.kv and
# checklist_screen.kv. Switched top_bar and its title column to
# adaptive_height and gave both labels a proper text_size.

<TimerScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(14)

        # =====================================================
        # Top bar: back button + title/subtitle. Back button is
        # top-aligned while the title column is nudged down a
        # little via a small spacer, so the arrow sits visibly
        # higher than the text block instead of both being
        # centered on the same line.
        # =====================================================

        MDBoxLayout:
            id: top_bar
            size_hint_y: None
            height: self.minimum_height
            adaptive_height: True
            spacing: dp(8)

            MDIconButton:
                id: back_button
                icon: "arrow-left"
                theme_icon_color: "Custom"
                pos_hint: {"top": 1}
                on_release: root.go_back()

            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: 1
                size_hint_y: None
                adaptive_height: True
                pos_hint: {"top": 1}

                Widget:
                    size_hint_y: None
                    height: dp(10)

                MDLabel:
                    id: header_label
                    text: "Pomodoro Timer"
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "medium"
                    size_hint_y: None
                    adaptive_height: True
                    text_size: self.width, None

                MDLabel:
                    id: subtitle_label
                    text: "Stay focused. One session at a time."
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    adaptive_height: True
                    text_size: self.width, None

        # =====================================================
        # Centered cluster: hourglass, timer, session info,
        # status message. Untouched.
        # =====================================================

        AnchorLayout:
            anchor_x: "center"
            anchor_y: "top"
            padding: 0, dp(24), 0, 0

            MDBoxLayout:
                orientation: "vertical"
                size_hint: None, None
                width: dp(300)
                adaptive_height: True
                spacing: dp(10)

                Widget:
                    size_hint_y: None
                    height: dp(18)

                AnchorLayout:
                    size_hint_y: None
                    height: dp(150)

                    HourglassWidget:
                        id: hourglass
                        size_hint: None, None
                        size: dp(150), dp(150)

                MDLabel:
                    id: timer_label
                    text: "25:00"
                    halign: "center"
                    text_size: self.width, None
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "large"
                    font_size: "56sp"
                    size_hint_y: None
                    height: dp(66)

                MDLabel:
                    id: session_label
                    text: "Focus Time"
                    halign: "center"
                    text_size: self.width, None
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "small"
                    size_hint_y: None
                    height: dp(26)

                MDLabel:
                    id: session_sub_label
                    text: "25 minute session"
                    halign: "center"
                    text_size: self.width, None
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(26)

                MDLabel:
                    id: status_label
                    text: ""
                    halign: "center"
                    text_size: self.width, None
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    height: dp(22)

        # =====================================================
        # Controls: reset (secondary) — play/pause (primary,
        # filled + larger) — settings (secondary). Untouched.
        # =====================================================

        MDBoxLayout:
            id: controls_row
            size_hint_y: None
            height: dp(96)
            spacing: dp(32)
            adaptive_width: True
            pos_hint: {"center_x": 0.5}

            MDIconButton:
                id: reset_button
                icon: "restart"
                theme_icon_color: "Custom"
                icon_size: "26sp"
                size_hint: None, None
                size: dp(76), dp(76)
                on_release: root.reset_timer()

            MDIconButton:
                id: toggle_button
                icon: "play"
                theme_icon_color: "Custom"
                icon_size: "26sp"
                size_hint: None, None
                size: dp(76), dp(76)
                on_release: root.toggle_timer()

            MDIconButton:
                id: settings_button
                icon: "cog-outline"
                theme_icon_color: "Custom"
                icon_size: "26sp"
                size_hint: None, None
                size: dp(76), dp(76)
                on_release: root.open_timer_dialog()