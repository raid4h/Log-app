#:kivy 2.3.1
#
# Main Checklist screen: list of checklist summary cards
# (widgets/checklist_card.py, built in Python) plus a single
# add-bar that opens the creation popup in checklist_screen.py.
# Individual checklist items are NOT shown or added here anymore --
# tapping a card navigates to checklist_detail_screen.kv for that.
#
# UI-only pass: removed the decorative left "+" icon from add_bar --
# only the filled square button on the right remains actionable.

<ChecklistScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        # top bar: back + title/subtitle
        MDBoxLayout:
            id: top_bar
            size_hint_y: None
            height: dp(64)
            spacing: dp(10)

            MDIconButton:
                id: back_button
                icon: "arrow-left"
                theme_icon_color: "Custom"
                pos_hint: {"top": 1}
                on_release: root.go_back()

            MDBoxLayout:
                orientation: "vertical"
                pos_hint: {"top": 1}

                Widget:
                    size_hint_y: None
                    height: dp(10)

                MDLabel:
                    id: header_label
                    text: "Checklists"
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "large"
                    bold: True

                MDLabel:
                    id: subtitle_label
                    text: "Tap a checklist to open it"
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"

        # scrollable list of checklist cards -- filled by
        # ChecklistScreen.load_checklists() in checklist_screen.py
        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False

            MDBoxLayout:
                id: checklist_list
                orientation: "vertical"
                spacing: dp(12)
                size_hint_y: None
                adaptive_height: True

        # add bar: dashed-border row with a prompt label and a filled
        # square "+" button on the right only.
        MDBoxLayout:
            id: add_bar
            size_hint_y: None
            height: dp(56)
            padding: dp(14), dp(4)
            spacing: dp(10)

            canvas.before:
                Color:
                    id: add_bar_border_color
                    rgba: 0, 0, 0, 0.3
                Line:
                    rounded_rectangle: self.x, self.y, self.width, self.height, 16
                    width: dp(1.2)
                    dash_length: 6
                    dash_offset: 4

            MDLabel:
                id: add_bar_label
                text: "New Checklist"
                theme_text_color: "Custom"
                font_style: "Body"
                role: "medium"
                valign: "middle"

            MDIconButton:
                id: add_button
                icon: "plus"
                theme_icon_color: "Custom"
                theme_bg_color: "Custom"
                radius: [10]
                size_hint: None, None
                size: dp(40), dp(40)
                pos_hint: {"center_y": 0.5}
                on_release: root.open_new_checklist_popup()