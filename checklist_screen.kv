#:kivy 2.3.1
#
# Main Checklist screen: list of checklist summary cards
# (widgets/checklist_card.py, built in Python) plus a single
# add-bar that opens the creation popup in checklist_screen.py.
# Individual checklist items are NOT shown or added here anymore --
# tapping a card navigates to checklist_detail_screen.kv for that.
#
# UI-only pass: removed the decorative left "+" icon from add_bar --
# only the filled square button on the right remains actionable.
#
# FIX: header_label/subtitle_label had no text_size, so on a narrow
# phone screen the subtitle wrapped to two lines but its parent box
# had no explicit height to grow into -- same overflow issue fixed
# in calendar_screen.kv. Also added text_size to add_bar_label so a
# longer prompt wraps/truncates instead of overflowing toward the
# button.
#
# FIX 2: header no longer matched timer_screen.py's Pomodoro header --
# this screen used font_style "Title"/role "large" + bold:True and
# dp(10) spacing, timer_screen.kv uses "Title"/role "medium" (not
# bold) and dp(8) spacing, producing a visibly bigger/bolder title
# and different back-arrow alignment side-by-side. Header structure
# now matches timer_screen.kv's exactly (same font role, same
# spacing, same spacer/pos_hint pattern for the back button). Top
# padding also increased (dp(20) -> dp(16),dp(28),dp(16),dp(16)) so
# the header sits lower and doesn't crowd a phone's status bar/notch,
# matching the same fix already applied to calendar_screen.kv.
#
# FIX 3: added a small spacer between top_bar and the scrollable card
# list -- cards were sitting too close to the header/back-button row.
# top_bar itself (back button + title/subtitle alignment) is
# untouched.

<ChecklistScreen>:

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(28), dp(16), dp(16)
        spacing: dp(20)

        # top bar: back + title/subtitle -- structure matches
        # timer_screen.kv's top_bar exactly. UNCHANGED.
        MDBoxLayout:
            id: top_bar
            size_hint_y: None
            height: self.minimum_height
            adaptive_height: True
            spacing: dp(8)

            MDIconButton:
                id: back_button
                icon: "arrow-left"
                theme_icon_color: "Custom"
                pos_hint: {"top": 1}
                on_release: root.go_back()

            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: 1
                size_hint_y: None
                adaptive_height: True
                pos_hint: {"top": 1}

                Widget:
                    size_hint_y: None
                    height: dp(10)

                MDLabel:
                    id: header_label
                    text: "Checklists"
                    theme_text_color: "Custom"
                    font_style: "Title"
                    role: "medium"
                    size_hint_y: None
                    adaptive_height: True
                    text_size: self.width, None

                MDLabel:
                    id: subtitle_label
                    text: "Tap a checklist to open it"
                    theme_text_color: "Custom"
                    font_style: "Body"
                    role: "small"
                    size_hint_y: None
                    adaptive_height: True
                    text_size: self.width, None

        # small breathing-room spacer -- pushes the card list down a
        # bit from the header without touching top_bar itself.
        Widget:
            size_hint_y: None
            height: dp(8)

        # scrollable list of checklist cards -- filled by
        # ChecklistScreen.load_checklists() in checklist_screen.py
        ScrollView:
            size_hint: 1, 1
            do_scroll_x: False

            MDBoxLayout:
                id: checklist_list
                orientation: "vertical"
                spacing: dp(12)
                size_hint_y: None
                adaptive_height: True

        # add bar: dashed-border row with a prompt label and a filled
        # square "+" button on the right only.
        MDBoxLayout:
            id: add_bar
            size_hint_y: None
            height: dp(56)
            padding: dp(14), dp(4)
            spacing: dp(10)

            canvas.before:
                Color:
                    id: add_bar_border_color
                    rgba: 0, 0, 0, 0.3
                Line:
                    rounded_rectangle: self.x, self.y, self.width, self.height, 16
                    width: dp(1.2)
                    dash_length: 6
                    dash_offset: 4

            MDLabel:
                id: add_bar_label
                text: "New Checklist"
                theme_text_color: "Custom"
                font_style: "Body"
                role: "medium"
                valign: "middle"
                shorten: True
                shorten_from: "right"
                text_size: self.width, None

            MDIconButton:
                id: add_button
                icon: "plus"
                theme_icon_color: "Custom"
                theme_bg_color: "Custom"
                radius: [10]
                size_hint: None, None
                size: dp(40), dp(40)
                pos_hint: {"center_y": 0.5}
                on_release: root.open_new_checklist_popup()